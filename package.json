{
  "name": "herdr-agents",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "herdr-backed subagent spawning and messaging across pi and Claude Code",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=26" },
  "pi": {
    "extensions": ["./packages/pi/src/index.ts"]
  },
  "bin": {
    "herdr-agents-mcp": "./packages/claude/bin/herdr-agents-mcp.ts"
  },
  "scripts": {
    "test": "vitest run --dir packages",
    "typecheck": "tsc --noEmit",
    "lint": "biome check packages/"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.0",
    "vitest": "^4.0.18"
  }
}
